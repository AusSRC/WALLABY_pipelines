includeConfig 'pipeline_components/nextflow/config/images.config'
includeConfig 'pipeline_components/nextflow/config/setonix.config'

profiles {
    setonix {
        workDir = '/scratch/ja3/wallaby_survey/work/'
        tmpDir = '/scratch/ja3/wallaby_survey/tmp/'

        process {
            cache = 'lenient'
            stageInMode = 'symlink'

            withName: download {
                executor = 'slurm'
                queue = 'copy'
                clusterOptions = '--nodes=1 --account=ja3 --time=4:00:00'
            }

            withName: linmos_mpi {
                executor = 'slurm'
                queue = 'work'
                module = ['singularity/4.1.0-mpi']
                clusterOptions = '--nodes=1-4 --ntasks=72 --mem-per-cpu=1800M --cpus-per-task=3 --account=ja3 --time=4:00:00'
            }

            withName: sofia {
                executor = 'slurm'
                queue = 'work'
                clusterOptions = '--mem=32G --account=ja3 --time=6:00:00'
            }

            withName: apply_flags {
                clusterOptions = '--mem=128G --account=ja3 --time=2:00:00'
            }
        }

        env {
            XDG_CACHE_HOME = "/scratch/ja3/wallaby_survey"
            XDG_CONFIG_HOME = "/scratch/ja3/wallaby_survey"
        }

        params {
            WORKDIR = "/scratch/ja3/wallaby_survey"
            CONFIG_DIR = "/software/projects/ja3/ashen/config/wallaby"

            TAP_CREDENTIALS = "$CONFIG_DIR/wallaby_tap.ini"
            CASDA_CREDENTIALS = "$CONFIG_DIR/casda.ini"
            DATABASE_ENV = "$CONFIG_DIR/database.env"

            SOFIA_CATALOG = "$CONFIG_DIR/racs_gt_150mJy_south.dat"
        }
    }
}

params {
    RUN_NAME = ""
    SER = ""
    SBID = ""
    IMAGE_CUBE = ""
    WEIGHTS_CUBE = ""

    AUSSRC_PIPELINE_COMPONENTS_IMAGE = "aussrc/pipeline_components:dev"
}
